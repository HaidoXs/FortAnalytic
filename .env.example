# Copy to .env.local and fill in.

# Island images from fortnite.gg (off by default).
# Only enable once fortnite.gg has agreed: see docs/fortnite-gg-request.md.
# NEXT_PUBLIC_ISLAND_IMAGES=fortnitegg
# FORTANALYTIC_CONTACT=https://your-site.example or you@example.com
# FORTNITE_GG_API_URL=https://example/api/island/{code}   # only if they give you an endpoint
# IMAGES_PER_RUN=400

# Collector tuning
# TOP_PER_GENRE=100
# FN_API_GAP_MS=240
